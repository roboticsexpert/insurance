NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://bimegold:bimegold@localhost:5433/bimegold?schema=public"

# Public URLs. In production: https://app.bimegold.com / https://api.bimegold.com
WEB_URL=http://localhost:5173
API_URL=http://localhost:3000

# 32+ chars each. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32-chars-min
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-32-chars-min

# Universal OTP for the MVP. Empty string disables it.
# The app REFUSES TO BOOT with this set in production unless ALLOW_MOCK_AUTH_IN_PROD=true.
AUTH_MOCK_OTP=1234
ALLOW_MOCK_AUTH_IN_PROD=false
ALLOW_MOCK_PAYMENT_IN_PROD=false

PAYMENT_GATEWAY=mock
SMS_PROVIDER=console

# Comma-separated. In production: https://app.bimegold.com
CORS_ORIGINS=http://localhost:5173
# Leave empty in dev; set to .bimegold.com in production so app/api share the refresh cookie.
COOKIE_DOMAIN=
