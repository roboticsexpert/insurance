{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bimegold-brand",
  // Same account as the bimegold.com zone — a Workers custom domain cannot span accounts.
  "account_id": "022e4e5b87a14dc3d0e17772f66b5d6b",
  "compatibility_date": "2026-08-19",
  // Static site — no Worker script. `dist/` is generated by tools/brand-gold/site.py.
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "brand.bimegold.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
