---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'مستندات و یادداشت‌های پژوهشی صنعت بیمه ایران' } = Astro.props;
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <meta name="theme-color" content="#fbfaf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14161a" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          {/* Two files rather than one recoloured by CSS: the lockup is charcoal + gold,
              so there is no single currentColor to swap. */}
          <picture>
            <source srcset="/brand/logo-on-dark.svg" media="(prefers-color-scheme: dark)" />
            <img class="logo" src="/brand/logo.svg" alt="Bime Gold" width="1093" height="328" />
          </picture>
          <span class="brand-label">مستندات صنعت بیمه ایران</span>
        </a>
        <nav>
          <a href="/">موضوع‌ها</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        یادداشت‌های داخلی پژوهش. هر موضوع تاریخ آخرین به‌روزرسانی و منابع خودش را دارد.
      </div>
    </footer>
  </body>
</html>
