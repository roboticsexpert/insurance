{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "insurance-docs",
  "account_id": "45d1cc1b84fce346e3b17965f6669181",
  "compatibility_date": "2026-08-19",
  // Static site — no Worker script, the built Astro output is served directly.
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "insurance.zisef.ir", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
