# رشته اتصال Postgres — دقیقاً همان دیتابیسی که `apps/api` استفاده می‌کند.
# جدول‌های CMS در اسکیمای `cms` می‌نشینند، نه در `public` که دست Prisma است،
# پس دو مهاجرت‌ساز به هم نمی‌خورند. با `pnpm db:up` بالا می‌آید.
DATABASE_URL=postgresql://bime247:bime247@127.0.0.1:5433/bime247

# کلید امضای توکن‌های پیشخان. در محیط عملیاتی حتماً عوضش کنید.
PAYLOAD_SECRET=CHANGE_ME

# آدرس خود سایت. بدون اسلش پایانی.
NEXT_PUBLIC_SERVER_URL=http://localhost:3100

# آدرس اپ خرید. سایت چیزی نمی‌فروشد و هر دکمه استعلام به اینجا می‌رود.
NEXT_PUBLIC_APP_URL=http://localhost:5173

# آدرس `apps/api`. فقط سمت سرور خوانده می‌شود و فقط برای `GET /catalog/reference/:key` —
# فهرست گزینه‌های فرم استعلام. اگر نباشد یا بالا نباشد، فرم همان فیلدها را نمی‌سازد و
# ویزارد خودش می‌پرسد؛ صفحه نمی‌شکند.
API_URL=http://localhost:3000/api/v1

# راز پیش‌نمایش پیش‌نویس‌ها
PREVIEW_SECRET=CHANGE_ME

# راز اجرای کرون‌جاب‌ها
CRON_SECRET=CHANGE_ME
