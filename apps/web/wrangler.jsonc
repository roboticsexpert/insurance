{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bimegold-web",
  // bimegold.com lives on this account, NOT the one apps/docs deploys to. A Workers
  // custom domain has to sit on the same account as its zone.
  "account_id": "022e4e5b87a14dc3d0e17772f66b5d6b",
  "compatibility_date": "2026-08-19",
  // Static SPA — no Worker script. `single-page-application` is what makes a hard
  // refresh on /p/travel/form serve index.html instead of a 404; react-router owns
  // routing once the bundle is up.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "app.bimegold.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
